generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  HOST
  ADMIN
  GUEST
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  PAUSED
}

enum LeadStatus {
  INITIATED
  RESPONDED
  CONFIRMED
  LOST
}

enum MembershipStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(190)
  passwordHash String    @db.VarChar(255)
  role         Role      @default(HOST)
  isTest       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  favorites    Favorite[]
  listings     Listing[]
  sessions     Session[]
  auditLogs    AuditLog[]
  contactChanges ContactEvent[] @relation("ContactActor")
  membershipHistory MembershipEvent[] @relation("MembershipHost")
  membershipChanges MembershipEvent[] @relation("MembershipActor")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

model Listing {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(190)
  title        String        @db.VarChar(100)
  summary      String        @db.VarChar(250)
  description  String        @db.Text
  city         String        @default("Quibdó") @db.VarChar(100)
  district     String        @db.VarChar(100)
  type         String        @db.VarChar(40)
  capacity     Int
  bedrooms     Int           @default(1)
  beds         Int           @default(1)
  bathrooms    Int           @default(1)
  priceNight   Int
  priceWeek    Int?
  extraCosts   String        @db.VarChar(500)
  amenities    Json
  photos       Json
  houseRules   String        @db.Text
  whatsapp     String?       @db.VarChar(20)
  status       ListingStatus @default(DRAFT)
  isDemo       Boolean       @default(false)
  featured     Boolean       @default(false)
  reviewedAt   DateTime?
  reviewNote   String?       @db.VarChar(500)
  rnt          String?       @db.VarChar(30)
  hostId       String
  host         User          @relation(fields: [hostId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contacts     Contact[]
  views        PageView[]
  reports      Report[]
  favorites    Favorite[]
  media        Media[]
  @@index([status, city, district])
  @@index([status, priceNight])
}

model Favorite {
  userId    String
  listingId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@id([userId, listingId])
}

model Media {
  id        String  @id @default(cuid())
  key       String  @unique @db.VarChar(100)
  mime      String  @db.VarChar(40)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model Contact {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  visitId   String?
  visit     VisitSession? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  status    LeadStatus @default(INITIATED)
  isSimulated Boolean @default(false)
  events    ContactEvent[]
  @@index([listingId, createdAt])
}

model ContactEvent {
  id        String @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status    LeadStatus
  note      String? @db.VarChar(500)
  lossReason String? @db.VarChar(100)
  actorId   String?
  actor     User? @relation("ContactActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([contactId, createdAt])
}

model VisitSession {
  id        String @id @default(cuid())
  tokenHash String @unique @db.VarChar(64)
  source    String @default("directo") @db.VarChar(100)
  createdAt DateTime @default(now())
  expiresAt DateTime
  views     PageView[]
  contacts  Contact[]
  @@index([expiresAt])
}

model MembershipEvent {
  id          String @id @default(cuid())
  hostId      String
  host        User @relation("MembershipHost", fields: [hostId], references: [id], onDelete: Cascade)
  status      MembershipStatus
  plan        String @db.VarChar(80)
  monthlyPrice Int @default(0)
  note        String @db.VarChar(500)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())
  actorId     String
  actor       User @relation("MembershipActor", fields: [actorId], references: [id])
  @@index([hostId, effectiveAt])
}

model PageView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  visitId   String?
  visit     VisitSession? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  isSimulated Boolean @default(false)
  @@unique([listingId, visitId])
  @@index([listingId, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason      String   @db.VarChar(500)
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  entityId  String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  @@index([entityId, createdAt])
}

model RateLimit {
  key       String   @id @db.VarChar(190)
  hits      Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
