{
  "name": "quedo/estadias",
  "type": "project",
  "description": "Plataforma de estadías temporales Quedo en Laravel y Blade.",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-pdo_mysql": "*",
    "laravel/framework": "^12.0"
  },
  "conflict": {
    "symfony/clock": ">=8.0",
    "symfony/console": ">=8.0",
    "symfony/css-selector": ">=8.0",
    "symfony/error-handler": ">=8.0",
    "symfony/event-dispatcher": ">=8.0",
    "symfony/finder": ">=8.0",
    "symfony/http-foundation": ">=8.0",
    "symfony/http-kernel": ">=8.0",
    "symfony/mailer": ">=8.0",
    "symfony/mime": ">=8.0",
    "symfony/process": ">=8.0",
    "symfony/routing": ">=8.0",
    "symfony/string": ">=8.0",
    "symfony/translation": ">=8.0",
    "symfony/uid": ">=8.0",
    "symfony/var-dumper": ">=8.0"
  },
  "suggest": {
    "ext-gd": "Necesaria para convertir fotografías subidas a formato WebP.",
    "ext-sodium": "Necesaria solo para verificar contraseñas heredadas en formato scrypt."
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "sort-packages": true,
    "preferred-install": "dist",
    "optimize-autoloader": true
  }
}
